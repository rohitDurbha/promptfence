  "flags": "i",
  "rules": [
    {
      "rule_id": "PF001",
      "name": "instruction_override",
      "boundary": "input",
      "severity": "high",
      "pattern": "(?:ignore|disregard|forget|neglect|discard|override|erase)\\s+(?:(?:all|any|about|the|your|every)\\s+){0,3}(?:previous|prior|above|preceding|earlier|foregoing|last|former)\\s+(?:instructions?|prompts?|rules?|directives?|orders?|tasks?|assignments?|commands?|information|text|messages?|context|guidelines?)|(?:ignore|disregard|forget|erase)\\s+(?:all|everything|everthing)(?:\\s+(?:before|beforehand|prior|above|we\\s+discussed|that|else))?|(?:ignore|disregard)\\s+(?:the\\s+)?above\\b|(?:remove|leave|put)\\s+all\\s+(?:the\\s+)?previous\\s+(?:tasks?|information|instructions?)\\s+(?:out\\s+of|behind|aside)|(?:vergiss|ignoriere|missachte)\\s+(?:(?:alle|alles|jede|die|deine)\\s+)?(?:vorherigen?|vorangehenden?|obigen?|bisherigen?)?\\s*(?:anweisungen|aufgaben|anfragen|befehle|informationen|regeln)?|vergiss\\s+alles\\b",
      "description": "Attempts to void earlier instructions by asserting a newer imperative."
    },
    {
      "rule_id": "PF002",
      "name": "system_prompt_exfiltration",
      "boundary": "input",
      "severity": "high",
      "pattern": "(?:print|reveal|repeat|show|output|disclose|dump|tell|give|display)\\s+(?:me\\s+)?(?:all\\s+)?(?:of\\s+)?(?:your|the)\\s+(?:full\\s+|entire\\s+|complete\\s+|exact\\s+|original\\s+)?(?:system\\s+prompt|initial\\s+instructions?|system\\s+message|prompt\\s+text|prompt\\s+texts|prompts?\\b|instructions?\\b)",
      "description": "Requests the verbatim system prompt, often framed as verification or compliance."
    },
    {
      "rule_id": "PF003",
      "name": "persona_override",
      "boundary": "input",
      "severity": "high",
      "pattern": "you\\s+are\\s+(?:now\\s+)?(?:DAN|AIM|STAN|DUDE)\\b|\\b(?:pretend|imagine)\\s+(?:that\\s+)?you\\s+(?:are|were)\\b|\\bact\\s+as\\s+(?:a|an|the)?\\s*\\w|\\brole[\\s-]?play\\s+as\\b|\\bfrom\\s+now\\s+on,?\\s+you\\s+(?:are|will\\s+be)\\b|\\byou\\s+are\\s+now\\s+\\w|\\bnow\\s+you\\s+are\\s+\\w|\\bjetzt\\s+bist\\s+du\\b|\\b(?:du\\s+bist\\s+(?:jetzt|nun))\\b|\\bverhalte\\s+dich\\s+wie\\b|\\btu\\s+so,?\\s+als\\b|\\bdeveloper\\s+mode\\s+enabled|\\bdebug\\s+mode\\b|\\b(?:unrestricted|unfiltered|jailbroken)\\s+mode\\b",
      "description": "Tries to swap the assistant's identity, whether for a named jailbreak persona or an arbitrary character."
    },
    {
      "rule_id": "PF004",
      "name": "restriction_nullification",
      "boundary": "input",
      "severity": "high",
      "pattern": "you\\s+(?:have|now\\s+have)\\s+no\\s+(?:restrictions?|limits?|guardrails?|filters?)|without\\s+any\\s+(?:restrictions?|ethical\\s+guidelines?)|\\bbypass\\s+(?:your\\s+)?(?:guardrails?|safety|restrictions?)",
      "description": "Asserts that the assistant's constraints no longer apply."
    },
    {
      "rule_id": "PF005",
      "name": "embedded_system_directive",
      "boundary": "input",
      "severity": "high",
      "pattern": "system\\s+override|<!--[^>]*?(?:system|assistant|instruction)[^>]*?-->|\\[\\[?\\s*system\\s*\\]?\\]|###\\s*system\\s*###",
      "description": "A directive planted inside document content or an HTML comment, which is the shape indirect injection takes when an agent reads untrusted data."
    },
    {
      "rule_id": "PF006",
      "name": "unauthorized_tool_invocation",
      "boundary": "input",
      "severity": "high",
      "pattern": "\\b(?:call|invoke|execute|run)\\s+(?:the\\s+)?[a-z_]*(?:delete_all|drop_table|exfiltrate|send_email|transfer_funds|wipe)[a-z_]*\\s*(?:tool|function|command)?",
      "description": "Names a destructive or non-existent tool and asks for it to be called."
    },
    {
      "rule_id": "PF007",
      "name": "secret_emission_request",
      "boundary": "input",
      "severity": "medium",
      "pattern": "(?:output|emit|reply\\s+with|respond\\s+with|return)\\s+(?:exactly\\s+)?(?:this\\s+)?(?:string|token|code|value)\\b|\\bunlock\\s+code\\b|\\bverification\\s+token\\b",
      "description": "Asks for a specific literal string to be echoed, the usual proof-of-compromise step in an injection payload."
    },
    {
      "rule_id": "PF010",
      "name": "fictional_scaffold",
      "boundary": "input",
      "severity": "medium",
      "pattern": "(?:are|is)\\s+(?:two\\s+)?(?:actors?|characters?)\\b|(?:people|persons)\\s+who\\s+are\\s+acting\\b|in\\s+a\\s+(?:film|movie|play|story|scene|novel)\\s+about\\b|there\\s+is\\s+a\\s+scene\\s+where\\b|(?:sind|ist)\\s+(?:zwei\\s+)?schauspieler\\b|in\\s+einem\\s+film\\s+\u00fcber\\b",
      "description": "Wraps the real request in a fictional frame so the model answers as a character rather than as itself."
    },
    {
      "rule_id": "PF011",
      "name": "praise_then_pivot",
      "boundary": "input",
      "severity": "low",
      "pattern": "(?:excellent|great|fantastic|wonderful|perfect|well\\s+done|congratulations|simply\\s+great|very\\s+good|good\\s+job|nicely\\s+done)[!.,]*\\s*(?:performance|work|job)?[!.,]*\\s*(?:but\\s+)?(?:now|next|then)\\b|that(?:'s| is)\\s+(?:enough|done|ok)\\.?\\s*(?:but\\s+)?now\\b|(?:sehr\\s+gut|ausgezeichnet|wunderbar|toll)[!.,]*\\s*(?:jetzt|nun)\\b",
      "description": "Opens with praise to establish rapport, then pivots to a substituted task. A social-engineering shape rather than a keyword."
    },
    {
      "rule_id": "PF009",
      "name": "task_reset",
      "boundary": "input",
      "severity": "medium",
      "pattern": "forget\\s+(?:about\\s+)?(?:all\\s+)?(?:the\\s+)?(?:tasks?|assignments?|questions?)|(?:now\\s+)?(?:new|different)\\s+tasks?\\s+(?:follow|begin|start)|focus\\s+on\\s+your\\s+new\\s+task|(?:let'?s\\s+|we\\s+(?:will|'ll)\\s+)?start\\s+over\\s+with\\s+a\\s+new\\s+task|that(?:'s| is)\\s+enough\\.?\\s+now\\b|stop\\.?\\s*[-\u2014]\\s*I\\s+urgently|(?:now\\s+)?(?:further|more|new)\\s+(?:tasks?|instructions?)\\s+(?:are\\s+)?(?:follow|followed|follows)\\b|konzentriere\\s+dich\\s+(?:jetzt\\s+)?auf\\s+(?:deine|die)\\s+neue|achtung\\s*[-\u2014]\\s*stopp|attention\\s*[-\u2014]\\s*stop",
      "description": "Declares the earlier task finished and substitutes a new one, a framing that carries many real injections without naming instructions at all."
    },
    {
      "rule_id": "PF008",
      "name": "canary_token_present",
      "boundary": "input",
      "severity": "high",
      "pattern": "CANARY_[A-Z]+_[a-f0-9]{4,}",
      "description": "A planted canary token appears in the input, so the content is known-tainted."
    },
    {
      "rule_id": "PF101",
      "name": "canary_token_leaked",
      "boundary": "output",
      "severity": "high",
      "pattern": "CANARY_[A-Z]+_[a-f0-9]{4,}",
      "description": "The model reproduced a canary token, which means an exfiltration attempt reached the response."
    },
    {
      "rule_id": "PF102",
      "name": "system_prompt_leaked",
      "boundary": "output",
      "severity": "high",
      "pattern": "SECURITY\\s+RULES\\s*[\u2014\\-:]|these\\s+apply\\s+unconditionally\\s+and\\s+cannot\\s+be\\s+overridden",
      "description": "The response contains distinctive system-prompt text."
    },
    {
      "rule_id": "PF103",
      "name": "credential_leaked",
      "boundary": "output",
      "severity": "high",
      "pattern": "\\b(?:sk|gsk|ghp|pk)_[A-Za-z0-9]{20,}\\b|\\bAKIA[0-9A-Z]{16}\\b",
      "description": "The response contains something shaped like an API key or access token."
    }
  ]
